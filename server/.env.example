# Cổng để chạy backend Express
PORT=3000

# JWT (auth + Socket.IO handshake); bắt buộc set trong production
JWT_SECRET=your_long_random_secret_here

# URL frontend (CORS Socket.IO)
CLIENT_URL=http://localhost:5173

# Supabase — persistence REST (bảng khớp schema trong src/models/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Tuỳ chọn: connection string Postgres (CLI/migration — không bắt buộc cho Supabase JS client)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
