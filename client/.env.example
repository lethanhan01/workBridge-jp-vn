# Mọi người copy file này, đổi tên thành .env và điền key thật vào

# Supabase (client browser — chỉ anon key)
VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Tuỳ chọn — backend Socket.IO + API (mặc định trong code: http://localhost:3000)
# VITE_SOCKET_URL=http://localhost:3000